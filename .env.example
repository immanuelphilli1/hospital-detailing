# Laravel backend API base URL (no trailing slash)
# e.g. http://localhost:8000 or https://api.yourapp.com
VITE_API_URL=http://localhost:8000

# Invoice API base URL (no trailing slash). Leave empty for local Vite (same-origin /api).
# On Render, point at your VPS, e.g. https://api.yourdomain.com
VITE_INVOICES_API_URL=https://ed-api.thetonytay.cloud
